# Modèle des variables d'environnement. En production, elles se saisissent dans le tableau de bord Render
# (jamais dans un fichier commité, jamais dans une conversation). En local : copier vers .env.local.

# Base Postgres (Supabase → Connect → « Session pooler »). Encoder les caractères spéciaux du mot de passe.
DATABASE_URL=

# Clé API Claude (console Anthropic → API keys). Sans elle, l'app fonctionne mais les agents restent en file.
ANTHROPIC_API_KEY=

# Seul compte autorisé.
OWNER_EMAIL=

# 32 caractères aléatoires minimum (Render le génère : generateValue).
SESSION_SECRET=

# Code à usage unique pour définir le mot de passe sur /setup (16 caractères minimum).
SETUP_TOKEN=

# Optionnel : mot de passe défini par variable plutôt que par /setup (npm run auth:hash).
# OWNER_PASSWORD_HASH=

# Sauvegardes chiffrées : 32 octets aléatoires en base64 (Render la génère). À conserver AUSSI hors de l'hébergeur.
BACKUP_KEY=

# Stockage externe S3 des sauvegardes (Backblaze B2, Cloudflare R2…). Optionnel mais fortement conseillé.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# BACKUP_S3_PREFIX=klubik-hq/

# Valeurs de départ des plafonds (USD) ; ensuite modifiables dans Réglages. Modèles par agent : dans Réglages.
MONTHLY_BUDGET_USD=30
MISSION_BUDGET_USD=3
MAX_STEPS_PER_TASK=30
WORKER_CONCURRENCY=3
# WORKER_ENABLED=false  # désactive le moteur (ex. second serveur)
